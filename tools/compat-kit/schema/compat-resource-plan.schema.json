{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-resource-plan.schema.json",
  "title": "Auto Storage custom resource integration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "source_contract_digest",
    "target",
    "package",
    "class_name",
    "game_test_namespace",
    "resources"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "auto_storage_compat_resource_plan" },
    "source_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": { "$ref": "#/$defs/target" },
    "package": { "$ref": "#/$defs/java_type" },
    "class_name": { "$ref": "#/$defs/java_member" },
    "game_test_namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mod_id", "display_name", "version"],
      "properties": {
        "mod_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "java_reserved_identifier": {
      "type": "string",
      "pattern": "(?:^|\\.)(?:_|abstract|assert|boolean|break|byte|case|catch|char|class|const|continue|default|do|double|else|enum|exports|extends|false|final|finally|float|for|goto|if|implements|import|instanceof|int|interface|long|module|native|new|non-sealed|null|open|opens|package|permits|private|protected|provides|public|record|requires|return|sealed|short|static|strictfp|super|switch|synchronized|this|throw|throws|to|transient|transitive|true|try|uses|var|void|volatile|when|while|with|yield)(?:\\.|$)"
    },
    "java_type": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$",
      "not": { "$ref": "#/$defs/java_reserved_identifier" }
    },
    "java_member": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
      "not": { "$ref": "#/$defs/java_reserved_identifier" }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "factory_member"],
      "properties": {
        "owner": { "$ref": "#/$defs/java_type" },
        "factory_member": { "$ref": "#/$defs/java_member" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "representative_item",
        "variant_aware",
        "bridge_name",
        "snapshot_key",
        "sample_amount",
        "test_provider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "representative_item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "variant_aware": { "type": "boolean" },
        "bridge_name": { "$ref": "#/$defs/java_member" },
        "snapshot_key": { "type": "string", "minLength": 1 },
        "sample_amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "test_provider": { "$ref": "#/$defs/provider" }
      }
    }
  }
}
