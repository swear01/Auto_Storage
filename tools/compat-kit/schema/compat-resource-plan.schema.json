{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-resource-plan.schema.json",
  "title": "Auto Storage custom resource integration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "source_contract_digest",
    "target",
    "package",
    "class_name",
    "resources"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "auto_storage_compat_resource_plan" },
    "source_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": { "$ref": "#/$defs/target" },
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "class_name": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mod_id", "display_name", "version"],
      "properties": {
        "mod_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "factory_member"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "factory_member": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "representative_item",
        "variant_aware",
        "bridge_name",
        "snapshot_key",
        "sample_amount",
        "test_provider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "representative_item": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "variant_aware": { "type": "boolean" },
        "bridge_name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "snapshot_key": { "type": "string", "minLength": 1 },
        "sample_amount": { "type": "integer", "minimum": 1 },
        "test_provider": { "$ref": "#/$defs/provider" }
      }
    }
  }
}
