{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-proposals.schema.json",
  "title": "Auto Storage unresolved compatibility proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "target",
    "source_audit_digest",
    "machine_candidates",
    "requirement_candidates"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "auto_storage_compat_proposals"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "source_audit_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/machine_candidate"
      }
    },
    "requirement_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement_candidate"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mod_id",
        "display_name",
        "version"
      ],
      "properties": {
        "mod_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "const": "needs_decision"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "template",
        "status",
        "evidence"
      ],
      "properties": {
        "member": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "template": {
          "enum": [
            "config_tick_ratio",
            "public_numeric_getter",
            "parallel_lanes"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "machine_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "status",
        "evidence",
        "rate_bindings"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "rate_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rate_binding"
          }
        }
      }
    },
    "requirement_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serializer_id",
        "field",
        "classification",
        "status",
        "evidence"
      ],
      "properties": {
        "serializer_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "transaction_representable",
            "station_descriptor_representable",
            "unsupported_live_state"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
