{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-conformance-plan.schema.json",
  "title": "Auto Storage compatibility conformance plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "source_contract_digest",
    "target",
    "package",
    "class_name",
    "families"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "auto_storage_compat_conformance_plan" },
    "source_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": { "$ref": "#/$defs/target" },
    "package": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "class_name": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mod_id", "display_name", "version"],
      "properties": {
        "mod_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "display_name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "factory_member"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "factory_member": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sample_recipe_id",
        "provider",
        "batch",
        "expected_deltas"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "sample_recipe_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "provider": { "$ref": "#/$defs/provider" },
        "batch": { "type": "integer", "minimum": 2 },
        "expected_deltas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "happy",
            "catalyst_tool_remainder",
            "multi_output"
          ],
          "properties": {
            "happy": { "$ref": "#/$defs/delta" },
            "catalyst_tool_remainder": { "$ref": "#/$defs/delta" },
            "multi_output": { "$ref": "#/$defs/delta" }
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "not": { "const": 0 }
      }
    }
  }
}
