{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-contract.schema.json",
  "title": "Auto Storage compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "target", "source_audit_sha256", "source_recipe_inventory_sha256", "families", "verification"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "auto_storage_compat_contract"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mod_id", "display_name", "version"],
      "properties": {
        "mod_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "display_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dependency": {"type": "string", "minLength": 1},
        "repositories": {
          "type": "array",
          "items": {"type": "string", "pattern": "^https://\\S+$"},
          "uniqueItems": true
        }
      }
    },
    "source_audit_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_recipe_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "status",
          "recipe_type",
          "station",
          "inputs",
          "outputs",
          "costs",
          "risks",
          "evidence",
          "decision"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "class": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "rejected", "needs_decision"]},
          "recipe_type": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
          "station": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["descriptor_id", "category", "variants"],
                "properties": {
                  "descriptor_id": {"type": "string", "minLength": 1},
                  "category": {"enum": ["instant", "process", "transform"]},
                  "variants": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["item", "rate"],
                      "properties": {
                        "item": {"type": "string", "minLength": 1},
                        "rate": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["numerator", "denominator"],
                          "properties": {
                            "numerator": {"type": "integer", "minimum": 0},
                            "denominator": {"type": "integer", "minimum": 1}
                          }
                        },
                        "bounds": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            ]
          },
          "inputs": {"$ref": "#/$defs/terms"},
          "outputs": {"$ref": "#/$defs/terms"},
          "costs": {"$ref": "#/$defs/costs"},
          "risks": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          },
          "decision": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture",
        "expected_game_tests",
        "game_test_task",
        "gradle_tasks",
        "checks",
        "evidence"
      ],
      "properties": {
        "fixture": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "expected_game_tests": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "game_test_task": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}
          ]
        },
        "gradle_tasks": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "uniqueItems": true
        },
        "evidence": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9_]+$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task", "source", "marker"],
              "properties": {
                "task": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
                "source": {"type": "string", "minLength": 1},
                "marker": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "resource_kind", "amount"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "resource_kind": {"type": "string", "minLength": 1},
          "amount": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "minLength": 1}
            ]
          },
          "selector": {"type": "string", "minLength": 1}
        }
      }
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_kind", "amount"],
        "properties": {
          "resource_kind": {"type": "string", "minLength": 1},
          "amount": {
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "string", "minLength": 1}
            ]
          },
          "selector": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
