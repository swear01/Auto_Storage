{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-audit.schema.json",
  "title": "Auto Storage compatibility audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scanner_format",
    "kind",
    "target",
    "artifact",
    "ancestry_classpath",
    "source",
    "structural_class_graph",
    "structural_hierarchy",
    "structural_candidate_inventory_sha256",
    "candidates",
    "recipe_data",
    "risks"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "source",
          "candidates"
        ],
        "properties": {
          "source": {
            "required": [
              "revision"
            ],
            "properties": {
              "revision": {
                "type": "string"
              }
            }
          },
          "candidates": {
            "anyOf": [
              {
                "required": [
                  "recipe_classes"
                ],
                "properties": {
                  "recipe_classes": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "recipe_types"
                ],
                "properties": {
                  "recipe_types": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "recipe_serializers"
                ],
                "properties": {
                  "recipe_serializers": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "recipe_builders"
                ],
                "properties": {
                  "recipe_builders": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "datagen_classes"
                ],
                "properties": {
                  "datagen_classes": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "client_viewer_classes"
                ],
                "properties": {
                  "client_viewer_classes": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "resource_apis"
                ],
                "properties": {
                  "resource_apis": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "station_classes"
                ],
                "properties": {
                  "station_classes": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "block_entity_classes"
                ],
                "properties": {
                  "block_entity_classes": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "files": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "scanner_format": {
      "const": 15
    },
    "kind": {
      "const": "auto_storage_compat_audit"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_count",
        "class_inventory_sha256",
        "sha256",
        "size"
      ],
      "properties": {
        "class_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "class_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ancestry_classpath": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "files"
      ],
      "properties": {
        "revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?:[^/]+/)*[^/]+\\.java$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "revision"
            ],
            "properties": {
              "revision": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "files": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "structural_hierarchy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "classification"
        ],
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*$"
          },
          "classification": {
            "$ref": "#/$defs/hierarchy"
          }
        }
      }
    },
    "structural_class_graph": {
      "type": "array",
      "maxItems": 300000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "owner_sha256",
          "metadata"
        ],
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
          },
          "owner_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "metadata": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/structural_metadata"
              }
            ]
          }
        }
      }
    },
    "structural_candidate_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_classes",
        "recipe_types",
        "recipe_serializers",
        "recipe_builders",
        "datagen_classes",
        "client_viewer_classes",
        "resource_apis",
        "station_classes",
        "block_entity_classes"
      ],
      "properties": {
        "recipe_classes": {
          "$ref": "#/$defs/candidates"
        },
        "recipe_types": {
          "$ref": "#/$defs/candidates"
        },
        "recipe_serializers": {
          "$ref": "#/$defs/candidates"
        },
        "recipe_builders": {
          "$ref": "#/$defs/candidates"
        },
        "datagen_classes": {
          "$ref": "#/$defs/candidates"
        },
        "client_viewer_classes": {
          "$ref": "#/$defs/candidates"
        },
        "resource_apis": {
          "$ref": "#/$defs/candidates"
        },
        "station_classes": {
          "$ref": "#/$defs/candidates"
        },
        "block_entity_classes": {
          "$ref": "#/$defs/candidates"
        }
      }
    },
    "recipe_data": {
      "$ref": "#/$defs/recipe_data"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "disposition",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "disposition": {
            "const": "needs_decision"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mod_id",
        "display_name",
        "version"
      ],
      "properties": {
        "mod_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "evidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "class_hierarchy",
            "name_term"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "structural_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_flags",
        "super_class",
        "interfaces"
      ],
      "properties": {
        "access_flags": {
          "type": "integer"
        },
        "super_class": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
            }
          ]
        },
        "interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
          }
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "evidence"
      ],
      "properties": {
        "method": {
          "const": "class_hierarchy"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "source_class",
          "public_signature",
          "classification",
          "hierarchy"
        ],
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*$"
          },
          "source_class": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
          },
          "public_signature": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "$ref": "#/$defs/classification"
          },
          "hierarchy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/hierarchy"
              }
            ]
          }
        }
      }
    },
    "recipe_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "digest",
        "sources",
        "declared_recipes",
        "effective_recipes",
        "serializers",
        "overrides"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256",
              "declared_recipes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(target_jar|data_root_[1-9][0-9]*)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "declared_recipes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000
              }
            }
          }
        },
        "serializers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serializer_id",
              "recipe_count",
              "conditional_recipes",
              "condition_types",
              "sample_recipe_ids",
              "fields",
              "max_array_sizes"
            ],
            "properties": {
              "serializer_id": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
              },
              "recipe_count": {
                "type": "integer",
                "minimum": 1
              },
              "sample_recipe_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                }
              },
              "fields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "max_array_sizes": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "conditional_recipes": {
                "type": "integer",
                "minimum": 0
              },
              "condition_types": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                }
              }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe_id",
              "sources"
            ],
            "properties": {
              "recipe_id": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
              },
              "sources": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "format": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "declared_recipes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "effective_recipes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        }
      }
    }
  }
}
