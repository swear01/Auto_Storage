{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swear01/Auto_Storage/tools/compat-kit/schema/compat-runtime-probe-plan.schema.json",
  "title": "Auto Storage reviewed runtime probe plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "source_audit_digest",
    "target",
    "config_values",
    "capability_surfaces"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "auto_storage_runtime_probe_plan"
    },
    "source_audit_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "config_values": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/config_value"
      }
    },
    "capability_surfaces": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/capability_surface"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mod_id",
        "display_name",
        "version"
      ],
      "properties": {
        "mod_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource_location": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "java_reserved_identifier": {
      "type": "string",
      "pattern": "(?:^|\\.)(?:_|abstract|assert|boolean|break|byte|case|catch|char|class|const|continue|default|do|double|else|enum|exports|extends|false|final|finally|float|for|goto|if|implements|import|instanceof|int|interface|long|module|native|new|non-sealed|null|open|opens|package|permits|private|protected|provides|public|record|requires|return|sealed|short|static|strictfp|super|switch|synchronized|this|throw|throws|to|transient|transitive|true|try|uses|var|void|volatile|when|while|with|yield)(?:\\.|$)"
    },
    "java_type": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$",
      "not": {
        "$ref": "#/$defs/java_reserved_identifier"
      }
    },
    "java_member": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
      "not": {
        "$ref": "#/$defs/java_reserved_identifier"
      }
    },
    "config_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "item",
        "accessor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "$ref": "#/$defs/resource_location"
        },
        "accessor": {
          "$ref": "#/$defs/numeric_accessor"
        }
      }
    },
    "capability_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "source",
        "item",
        "accessor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "$ref": "#/$defs/resource_location"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "$ref": "#/$defs/resource_location"
        },
        "accessor": {
          "$ref": "#/$defs/boolean_accessor"
        }
      }
    },
    "numeric_accessor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "static_field_value_get"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "static_method"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type",
            "block_id"
          ],
          "properties": {
            "kind": {
              "const": "registry_block_method"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "number"
            },
            "block_id": {
              "$ref": "#/$defs/resource_location"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "constant",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "enum_constant_numeric_field"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "constant": {
              "$ref": "#/$defs/java_member"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "number"
            }
          }
        }
      ]
    },
    "boolean_accessor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "static_field_value_get"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "static_method"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "member",
            "value_type",
            "block_id"
          ],
          "properties": {
            "kind": {
              "const": "registry_block_method"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "boolean"
            },
            "block_id": {
              "$ref": "#/$defs/resource_location"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner",
            "constant",
            "member",
            "value_type"
          ],
          "properties": {
            "kind": {
              "const": "enum_constant_numeric_field"
            },
            "owner": {
              "$ref": "#/$defs/java_type"
            },
            "constant": {
              "$ref": "#/$defs/java_member"
            },
            "member": {
              "$ref": "#/$defs/java_member"
            },
            "value_type": {
              "const": "boolean"
            }
          }
        }
      ]
    }
  }
}
