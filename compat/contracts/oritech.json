        "common/src/main/java/rearth/oritech/block/base/entity/MachineBlockEntity.java#calculateEnergyUsage",
        "common/src/main/java/rearth/oritech/block/base/entity/MachineBlockEntity.java#checkCraftingFinished",
        "common/src/main/java/rearth/oritech/init/OritechConfig.java#pulverizerData",
        "common/src/main/java/rearth/oritech/util/MachineAddonController.java#DEFAULT_ADDON_DATA"
      ],
