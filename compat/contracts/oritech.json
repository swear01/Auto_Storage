        "common/src/main/java/rearth/oritech/init/recipes/OritechRecipe.java#getInputs",
        "common/src/main/java/rearth/oritech/init/recipes/OritechRecipe.java#getResults",
        "common/src/main/java/rearth/oritech/init/recipes/OritechRecipe.java#getFluidInput",
        "common/src/main/java/rearth/oritech/init/recipes/OritechRecipe.java#getTime",
        "common/src/main/java/rearth/oritech/init/recipes/OritechRecipe.java#isSpecial",
        "common/src/main/java/rearth/oritech/init/recipes/RecipeContent.java#PULVERIZER",
